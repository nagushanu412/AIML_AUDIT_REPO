# AIML Audit — Backend (FastAPI on Railway)
# Copy to backend/.env for local development. On Railway, set these in the service Variables tab.

# --- Environment ---
ENVIRONMENT=production

# --- Database (Railway PostgreSQL plugin injects DATABASE_URL automatically) ---
# Prefer DATABASE_URL in production — do not use localhost.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# Local fallback (only if DATABASE_URL is not set):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=AI_NEMO_DB
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here

# --- Server (Railway sets PORT automatically) ---
API_HOST=0.0.0.0
# PORT=8000
# API_PORT=8000

# --- CORS (comma-separated; include your Vercel production URL) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Allow any localhost port when Next.js picks 3001, 3002, etc.
CORS_ORIGIN_REGEX=http://localhost:\d+

# --- JWT (REQUIRED in production — generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# --- Demo seed user (created on API startup if missing) ---
DEMO_USER_EMAIL=auditor@demo.auditai.com
DEMO_USER_PASSWORD=AuditAI2026!

# --- Upload security ---
MAX_UPLOAD_MB=10

# --- Frontend URL (used in invite emails) ---
FRONTEND_URL=http://localhost:3000

# --- SMTP (optional — without these, invite links are logged to the API console) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=AuditAI Platform <your-email@gmail.com>
# SMTP_USE_TLS=true
# INVITE_TOKEN_EXPIRE_DAYS=7
